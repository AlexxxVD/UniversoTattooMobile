{
  "expo": {
    "name": "UniversoTattooMobile",
    "slug": "UniversoTattooMobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo_untattoo2.png",
    "scheme": "universotattoo",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.universotattoo.mobile",
      "associatedDomains": [
        "applinks:universotattoo.com.ar",
        "applinks:www.universotattoo.com.ar"
      ],
      "config": {
        "googleMapsApiKey": "YOUR_IOS_GOOGLE_MAPS_API_KEY"
      },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Usamos tu ubicación para mostrarte cómo llegar a nuestra tienda en el mapa.",
        "LSApplicationQueriesSchemes": [
          "comgooglemaps"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0E1116",
        "foregroundImage": "./assets/images/logo_untattoo2.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "YOUR_ANDROID_GOOGLE_MAPS_API_KEY"
        }
      },
      "package": "com.universotattoo.mobile",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "universotattoo.com.ar",
              "pathPrefix": "/auth"
            },
            {
              "scheme": "https",
              "host": "www.universotattoo.com.ar",
              "pathPrefix": "/auth"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo_untattoo2.png",
          "imageWidth": 250,
          "resizeMode": "contain",
          "backgroundColor": "#0E1116",
          "dark": {
            "backgroundColor": "#0E1116"
          }
        }
      ],
      "expo-web-browser",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "fed3c69f-166a-4331-b228-76763054b947"
      }
    }
  }
}
